# ── Database (required for the admin panel and live storefront) ──
# Supabase → Project Settings → Database → Connection string (URI).
# Use the "Transaction pooler" string on serverless hosts (Vercel); prepared statements are already disabled.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase Storage (prescriptions = private bucket, product-images = public bucket) ──
# Without these, files are stored in ./.data/storage (fine for local development only).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret-never-expose-to-the-browser

# Optional
# SHOP_TZ=Asia/Kolkata
# DATABASE_POOL_MAX=5
